# 生产环境 API 前缀；默认同源 /api
# VITE_API_BASE_URL=https://api.example.com/api

# 开发代理目标（留空时自动读取 ../apps/api/.env 的 PORT）
# VITE_PROXY_TARGET=http://127.0.0.1:3100

# 实时通知 WebSocket；默认使用当前页面同源 /ws
# VITE_WS_URL=ws://127.0.0.1:3100/ws

# DH_live 数字人静态资源目录（可选）
# DH_LIVE_STATIC_DIR=../DH_live-main/DH_live-main/web_demo/static
