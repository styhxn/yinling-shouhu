# Docker Compose 环境变量模板：复制为 .env 后修改，不要提交 .env
# 执行 ./deploy.sh 会自动创建 .env、生成密钥并推断服务器地址
# 会话签名，生产必须替换为足够长的随机串
SESSION_SECRET=replace-with-a-long-random-string

# PostgreSQL（docker compose 的 db 服务）
# 密码会被拼进 DATABASE_URL，只使用字母、数字和 ._~-
POSTGRES_DB=yinling
POSTGRES_USER=yinling
POSTGRES_PASSWORD=replace-with-a-strong-password
DB_POOL_MAX=10

# 对外访问与端口
APP_PORT=3100
APP_BASE_URL=http://localhost:3100
# 纯 HTTP 演示用 0；启用 HTTPS 后必须改为 1
COOKIE_SECURE=0
# 仅在 Nginx/Caddy 等反向代理后设为 1；直接暴露 IP 时保持 0
TRUST_PROXY=0
CORS_ORIGINS=

# 演示模式：1 开放演示账号与种子数据；正式环境改为 0
DEMO_MODE=1

# 模型：任选其一填写；全部留空时自动使用 Mock
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=
AMAP_WEB_KEY=

# 限流
RATE_LIMIT_ENABLED=1
