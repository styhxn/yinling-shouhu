# Docker Compose 环境变量模板：复制为 .env 后修改，不要提交 .env
# 会话签名，生产必须替换为足够长的随机串
SESSION_SECRET=replace-with-a-long-random-string

# PostgreSQL（docker compose 的 db 服务）
POSTGRES_DB=yinling
POSTGRES_USER=yinling
POSTGRES_PASSWORD=replace-with-a-strong-password
DB_POOL_MAX=10

# 对外地址与 Cookie
APP_BASE_URL=http://localhost:3100
# 纯 HTTP 演示用 0；启用 HTTPS 后必须改为 1
COOKIE_SECURE=0
TRUST_PROXY=1
CORS_ORIGINS=

# 模型：任选其一填写；全部留空时自动使用 Mock
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=
AMAP_WEB_KEY=

# 限流
RATE_LIMIT_ENABLED=1
