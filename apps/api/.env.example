# 服务
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173

# 演示
DEMO_MODE=1
DEMO_RESET_TOKEN=change-me

# 会话与加密
SESSION_SECRET=change-me
SESSION_TTL_MS=604800000
DATA_DIR=./data
# 上传文件与运行时静态资源目录
PUBLIC_DIR=./public
# 生产模式下的前端构建目录（相对 apps/api 工作目录）
WEB_DIST_DIR=../web/dist
# 32 字节 base64；二选一，留空则自动生成 data/master.key
MASTER_KEY=
APP_MASTER_KEY_B64=

# 模型（OpenAI 兼容）
LLM_MOCK=0
LLM_RPS=2
LLM_BURST=4
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_EMBED_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 火山方舟 / 豆包
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# 讯飞星火（可选）
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_URL=wss://spark-api.xf-yun.com/v3.1/chat
SPARK_DOMAIN=general

# 高德
# AMAP_WEB_KEY：Web 服务（天气/地理编码）
# AMAP_JS_KEY：Web 端 JS API（地图/围栏，前端使用）
AMAP_WEB_KEY=
AMAP_JS_KEY=
