# 服务
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173

# 演示
DEMO_MODE=1
DEMO_RESET_TOKEN=change-me

# 会话与加密
SESSION_SECRET=change-me
SESSION_TTL_MS=604800000
# 留空时：生产自动开启 Secure，开发关闭；HTTPS 部署请设为 1
COOKIE_SECURE=
DATA_DIR=./data
# 上传文件与运行时静态资源目录
PUBLIC_DIR=./public
# 生产模式下的前端构建目录（相对 apps/api 工作目录）
WEB_DIST_DIR=../../frontend/dist
# 32 字节 base64；二选一，留空则自动生成 data/master.key
MASTER_KEY=
APP_MASTER_KEY_B64=

# 跨域与代理
# 生产前后端分离时填写前端源，多个用英文逗号分隔；留空时开发放行本地 5173，生产只放行 APP_BASE_URL
CORS_ORIGINS=
# 部署在 Nginx/Caddy 等反向代理后面时设为 1，用于正确识别客户端 IP
TRUST_PROXY=0

# 限流（默认开启；演示或压测时可设 0 一键关闭）
RATE_LIMIT_ENABLED=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AI_MAX=40
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_LOCATION_MAX=120

# 数据保留（天）
RETENTION_LOCATION_DAYS=90
RETENTION_TOOL_LOG_DAYS=30
RETENTION_AUDIT_DAYS=180
RETENTION_ALERT_DAYS=180
RETENTION_POSTER_DAYS=7

# 模型（OpenAI 兼容）
LLM_MOCK=0
LLM_RPS=2
LLM_BURST=4
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_EMBED_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义千问
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 火山方舟 / 豆包
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# 讯飞星火（可选）
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_URL=wss://spark-api.xf-yun.com/v3.1/chat
SPARK_DOMAIN=general

# 高德
# AMAP_WEB_KEY：Web 服务（天气/地理编码）
# AMAP_JS_KEY：Web 端 JS API（地图/围栏，前端使用）
AMAP_WEB_KEY=
AMAP_JS_KEY=
