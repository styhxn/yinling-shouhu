{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@eha/shared": ["packages/shared/dist/index.d.ts"],
      "@eha/shared/*": ["packages/shared/dist/*"],
      "@eha/adapters": ["packages/adapters/dist/index.d.ts"],
      "@eha/adapters/*": ["packages/adapters/dist/*"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  }
}
